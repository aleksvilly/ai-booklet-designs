{
  "schemaVersion": 1,
  "description": "Decorative elements each style places on its pages. The live editor controls them for any style with the same sliders: amount, size, position (around the page edge), variation (how much pages differ) and colour. Keys under 'styles' are style IDs from styles.json; 'default' is used by every style without its own set. Elements are listed in priority order: amount reveals them from the top.",
  "fields": {
    "kind": "Shape primitive drawn by styles.css (.se-<kind>). See 'kinds'.",
    "color": "Palette slot: c1 (page paper), c2, c3, c4, or ink (the page's text colour). Each style decides which slot is its accent.",
    "size": "Fraction of the page width (0–1). For edge kinds it is the thickness; for fill kinds the inset or strength.",
    "anchor": "Position on the page edge, clockwise from the top-left corner: 0 top-left, 0.25 top-right, 0.5 bottom-right, 0.75 bottom-left. Ignored by fill kinds.",
    "rotate": "Degrees.",
    "opacity": "0–1.",
    "thickness": "Ring/arc stroke as a fraction of the element size.",
    "text": "Optional { en, ru } label for text kinds.",
    "variant": "Optional. 'filled' draws stamps as solid badges with paper-coloured text."
  },
  "kinds": {
    "point": [
      "ring",
      "arc",
      "disc",
      "blot",
      "petal",
      "star",
      "cross",
      "dots",
      "lines",
      "slash",
      "bar",
      "pill",
      "stamp",
      "text"
    ],
    "edge": [
      "band",
      "ticker",
      "zigzag",
      "drip",
      "filmstrip"
    ],
    "fill": [
      "frame",
      "brackets",
      "scanlines",
      "confetti",
      "vignette",
      "tape"
    ]
  },
