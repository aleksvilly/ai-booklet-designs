---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Free AI Event Programme & Gallery Booklet Generator — Exhibition Guides" description="Free AI event programme & gallery booklet generator. Create professional exhibition guides, gallery night programmes, concert booklets, and event schedules. Print-ready." lang="en" categoryFilter="events">
  <Header slot="header" lang="en" activeNav="events" />

  <section class="hero" id="events-hero">
    <div class="hero-intro">
      <p class="eyebrow">AI Event &amp; Exhibition Editorial System</p>
      <h1>Event Programme &amp; Gallery<br><em>Booklet Designs</em></h1>
      <p class="hero-copy">Create high-impact programmes for gallery openings, art exhibitions, music concerts, and conferences. Clean schedules, artist bios, and print-ready PDF export.</p>
      <div class="hero-actions">
        <a class="primary-button" href={`${import.meta.env.BASE_URL}/#generation-form`}>Generate Event Booklet — Free</a>
        <a class="secondary-button" href="#collection">Browse Examples</a>
      </div>
    </div>
  </section>

  <section class="collection-section" id="collection">
    <div class="collection-header">
      <div>
        <h2>Event &amp; Exhibition Booklet Collection</h2>
        <p>Editorial booklet designs tailored for gallery nights, cultural events, and performance programmes.</p>
      </div>
    </div>
    <div class="booklet-grid" id="booklet-grid"></div>
    <nav class="pagination" id="pagination" aria-label="Booklet navigation"></nav>
  </section>

  <Footer slot="footer" />
</BaseLayout>
