---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Free AI Birthday & Personal Gift Booklet Generator — Custom Tribute Albums" description="Free AI birthday & personal gift booklet generator. Create memorable editorial booklets, tribute albums, and personalized photo story gifts. Print-ready, automatic." lang="en" categoryFilter="gifts">
  <Header slot="header" lang="en" activeNav="gifts" />

  <section class="hero" id="gifts-hero">
    <div class="hero-intro">
      <p class="eyebrow">AI Personal Gift &amp; Storybook System</p>
      <h1>Birthday &amp; Personal Gift<br><em>Booklet Designs</em></h1>
      <p class="hero-copy">Surprise loved ones with a custom editorial booklet. Perfect for milestone birthdays, anniversaries, family history albums, and personal tribute gifts.</p>
      <div class="hero-actions">
        <a class="primary-button" href={`${import.meta.env.BASE_URL}/#generation-form`}>Generate Gift Booklet — Free</a>
        <a class="secondary-button" href="#collection">Browse Examples</a>
      </div>
    </div>
  </section>

  <section class="collection-section" id="collection">
    <div class="collection-header">
      <div>
        <h2>Gift &amp; Tribute Booklet Collection</h2>
        <p>Editorial booklet designs tailored for birthdays, anniversaries, and personal celebrations.</p>
      </div>
    </div>
    <div class="booklet-grid" id="booklet-grid"></div>
    <nav class="pagination" id="pagination" aria-label="Booklet navigation"></nav>
  </section>

  <Footer slot="footer" />
</BaseLayout>
