---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="Генератор программ мероприятий и выставочных буклетов на ИИ — Программы событий" description="Бесплатный ИИ генератор программ мероприятий и гидов по выставкам. Создавайте буклеты для выставок, концертов и вернисажей. Готово к печати." lang="ru" categoryFilter="events">
  <Header slot="header" lang="ru" activeNav="events" />

  <section class="hero" id="events-hero">
    <div class="hero-intro">
      <p class="eyebrow">ИИ Верстка Программ Мероприятий и Выставок</p>
      <h1>Программы Мероприятий<br><em>Дизайны Выставочных Буклетов</em></h1>
      <p class="hero-copy">Создавайте впечатляющие программы для открытий галерей, художественных выставок, концертов и конференций. Расписания, биографии участников и экспорт в PDF для печати.</p>
      <div class="hero-actions">
        <a class="primary-button" href={`${import.meta.env.BASE_URL}/ru/#generation-form`}>Создать программу — Бесплатно</a>
        <a class="secondary-button" href="#collection">Смотреть примеры</a>
      </div>
    </div>
  </section>

  <section class="collection-section" id="collection">
    <div class="collection-header">
      <div>
        <h2>Коллекция программ мероприятий</h2>
        <p>Дизайны буклетов для галерейных вечеров, культурных событий и вернисажей.</p>
      </div>
    </div>
    <div class="booklet-grid" id="booklet-grid"></div>
    <nav class="pagination" id="pagination" aria-label="Навигация буклетов"></nav>
  </section>

  <Footer slot="footer" />
</BaseLayout>
