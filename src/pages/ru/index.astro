---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="AI Booklet Designs — уникальные ИИ-буклеты к любому событию" description="ИИ-буклеты для любого человека и к любому событию — подарки на день рождения, меню для кафе, программы мероприятий, свадебные буклеты. Бесплатно, автоматически, готово к печати." lang="ru">
  <Header slot="header" lang="ru" activeNav="home" />

  <section class="hero" id="generate">
    <div class="hero-intro">
      <p class="eyebrow" data-i18n="hero_eyebrow">ИИ-буклеты — бесплатно, автоматически, уникально</p>
      <h1 data-i18n="hero_title">Для любого человека.<br><em>К любому событию.</em></h1>
      <p class="hero-copy" data-i18n="hero_copy">Подарок на день рождения джазовому фанату. Меню для новой кофейни. Программа галерейного вечера. Буклет на свадьбу. Опишите идею — уникальный полиграфический буклет создаётся автоматически.</p>
      <ul class="hero-usecases" aria-label="Примеры использования">
        <li data-i18n="usecase_gift">🎁 <strong>Подарок</strong> — день рождения, юбилей, выпускной</li>
        <li data-i18n="usecase_business">☕ <strong>Бизнес</strong> — меню кафе, история бренда, запуск продукта</li>
        <li data-i18n="usecase_event">🎉 <strong>Событие</strong> — свадьба, конференция, открытие галереи</li>
        <li data-i18n="usecase_passion">🎨 <strong>Увлечение</strong> — кино, музыка, архитектура, спорт</li>
      </ul>
      <div class="hero-actions">
        <a class="primary-button" href="#generation-form" data-i18n="btn_create">Создать буклет — бесплатно</a>
        <a class="secondary-button" href="#collection" data-i18n="btn_see_examples">Смотреть примеры</a>
        <button class="text-button" id="surprise-button" type="button" data-i18n="btn_surprise">Удиви меня ↗</button>
      </div>
    </div>
    <form class="request-form hero-generator" id="generation-form" action="https://ntfy.sh/ai-booklet-8bcc753d24dacb6d280ae36b" method="post">
      <div class="generator-heading">
        <div>
          <p class="eyebrow" data-i18n="form_eyebrow">Сгенерировать сейчас</p>
          <h2 data-i18n="form_title">Запросить буклет</h2>
        </div>
        <span class="automation-badge"><i aria-hidden="true"></i> <span data-i18n="form_badge">Автоматически</span></span>
      </div>

      <input type="hidden" name="request_type" value="booklet_generation">
      <input type="hidden" name="count" value="1">
      <input class="form-honeypot" name="_gotcha" type="text" tabindex="-1" autocomplete="off">

      <div class="request-fields">
        <label class="field-wide">
          <span data-i18n="lbl_topic">Тема буклета</span>
          <input id="booklet-topic" name="topic" type="text" maxlength="140" data-i18n-ph="ph_topic" placeholder="Необязательно — введите тему или выберите из энциклопедии">
        </label>
        <input id="topic-path" name="topic_path" type="hidden" value="">
        <details class="topic-explorer field-wide" id="topic-explorer">
          <summary>
            <span data-i18n="summary_explorer">Открыть энциклопедию тем</span>
            <small data-i18n="summary_explorer_sub">Категория → тема → подтема</small>
          </summary>
          <div class="topic-explorer-panel">
            <label class="topic-search-label">
              <span data-i18n="lbl_find_topic">Найти тему</span>
              <input id="topic-catalog-search" type="search" data-i18n-ph="ph_search_topic" placeholder="Например: теннис, свадьба, ИИ…" autocomplete="off">
            </label>
            <div class="topic-wheel" id="topic-wheel" aria-label="Topic path"></div>
            <p class="topic-path-preview" id="topic-path-preview" data-i18n="topic_preview_default">Выберите любой уровень. Самый глубокий выбранный уровень станет темой буклета.</p>
            <div class="topic-search-results" id="topic-search-results" hidden></div>
          </div>
        </details>
        <label class="field-wide range-field" id="style-profile-label">
          <span data-i18n="lbl_editorial_profile">Редакционный стиль</span>
          <output id="style-profile-output" data-i18n="auto_profile">Автоматический / без профиля</output>
          <select id="style-profile-select" name="style" required>
            <option value="auto" data-i18n="auto_profile">Автоматический / без профиля</option>
          </select>
        </label>
        <label>
          <span data-i18n="lbl_visual_language">Визуальный язык</span>
          <select name="visual_mode">
            <option value="auto" selected data-i18n="opt_auto">Автоматически</option>
            <option value="minimal" data-i18n="opt_minimal">Минималистичный</option>
            <option value="abstract" data-i18n="opt_abstract">Абстрактный / экспериментальный</option>
            <option value="mixed" data-i18n="opt_mixed">Смешанный</option>
          </select>
        </label>
        <label class="range-field">
          <span data-i18n="lbl_chaos">Уровень хаоса дизайна</span>
          <output id="chaos-output">0 — Строгий и безопасный</output>
          <select id="chaos-level-select" name="chaos_level">
            <option value="-1">Авто (умный выбор)</option>
            <option value="0" selected>0 — Строгий и безопасный</option>
            <option value="1">1 — Сбалансированный журнальный</option>
            <option value="2">2 — Выразительная верстка</option>
            <option value="3">3 — Дикая типографика</option>
            <option value="4">4 — Радикальные ломаные сетки</option>
            <option value="5">5 — Полный эксперимент</option>
          </select>
        </label>
        <label>
          <span data-i18n="lbl_fonts">Макс. количество шрифтов</span>
          <select name="max_fonts">
            <option value="2" selected>2 шрифта (рекомендуется)</option>
            <option value="3">3 шрифта</option>
            <option value="4">4 шрифта</option>
          </select>
        </label>
        <label class="field-wide">
          <span data-i18n="lbl_custom_style">Пожелания к стилю</span>
          <input name="custom_style" type="text" maxlength="120" data-i18n-ph="ph_custom_style" placeholder="Например: журнал 1970-х, высококонтрастный чёрно-белый">
        </label>
        <label>
          <span data-i18n="lbl_ai_engine">ИИ движок текста</span>
          <select name="ai_provider">
            <option value="auto" selected data-i18n="opt_ai_auto">Авто (умный выбор)</option>
            <option value="openai-first">OpenAI (GPT-4o)</option>
            <option value="gemini-first">Google Gemini</option>
            <option value="local" data-i18n="opt_ai_local">Локальный генератор</option>
          </select>
        </label>
        <label>
          <span data-i18n="lbl_custom_fonts">Свой Google Font</span>
          <input name="custom_fonts" type="text" maxlength="80" data-i18n-ph="ph_custom_fonts" placeholder="Например: Playfair Display, Space Grotesk">
        </label>
        <label class="field-wide">
          <span data-i18n="lbl_extra_details">Дополнительные детали</span>
          <textarea name="description" rows="2" maxlength="280" data-i18n-ph="ph_extra_details" placeholder="Например: 4 главы, акцент на фото, тёплый тон"></textarea>
        </label>
      </div>

      <div class="form-actions">
        <button class="primary-button field-wide" id="request-submit-button" type="submit" data-i18n="btn_submit_request">Отправить запрос →</button>
      </div>
    </form>
  </section>

  <section class="collection-section" id="collection">
    <div class="collection-header">
      <div>
        <h2 data-i18n="collection_title">Коллекция буклетов</h2>
        <p data-i18n="collection_subtitle">Просматривайте готовые editorial-буклеты. Открывайте любой дизайн для настройки типографики, фотосеток или экспорта в PDF.</p>
      </div>
      <div class="collection-controls">
        <label class="search-box">
          <span class="sr-only">Поиск буклетов</span>
          <input id="collection-search" type="search" placeholder="Поиск по теме, стилю, дате…">
        </label>
      </div>
    </div>
    <div class="booklet-grid" id="booklet-grid"></div>
    <nav class="pagination" id="pagination" aria-label="Booklet navigation"></nav>
  </section>

  <section class="contact-section" id="contact">
    <div class="contact-card">
      <div class="contact-intro">
        <p class="eyebrow" data-i18n="contact_eyebrow">Связаться с нами</p>
        <h2 data-i18n="contact_title">Контакты и обратная связь</h2>
        <p data-i18n="contact_copy">Есть вопросы, индивидуальные пожелания или идеи для сотрудничества? Напишите нам прямо сейчас.</p>
      </div>
      <form class="contact-form" id="contact-form" action="https://formspree.io/f/meeyvjjd" method="POST">
        <label>
          <span data-i18n="lbl_name">Ваше имя</span>
          <input name="name" type="text" required data-i18n-ph="ph_name" placeholder="Имя или студия">
        </label>
        <label>
          <span data-i18n="lbl_email">Email адрес</span>
          <input name="_replyto" type="email" required data-i18n-ph="ph_email" placeholder="name@example.com">
        </label>
        <label>
          <span data-i18n="lbl_phone">Телефон (опционально)</span>
          <input name="phone" type="tel" data-i18n-ph="ph_phone" placeholder="+7 900 000 0000">
        </label>
        <label class="field-wide">
          <span data-i18n="lbl_message">Сообщение</span>
          <textarea name="message" rows="4" required data-i18n-ph="ph_message" placeholder="Чем мы можем вам помочь?"></textarea>
        </label>
        <button class="primary-button field-wide" type="submit" data-i18n="btn_send_message">Отправить сообщение →</button>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
