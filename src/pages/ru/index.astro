---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="AI Booklet Designs — уникальные ИИ-буклеты к любому событию" description="ИИ-буклеты для любого человека и к любому событию — подарки на день рождения, меню для кафе, программы мероприятий, свадебные буклеты. Бесплатно, автоматически, готово к печати." lang="ru">
  <Header slot="header" lang="ru" activeNav="home" />

  <section class="hero" id="generate">
    <div class="hero-center">
      <p class="eyebrow" data-i18n="hero_eyebrow">Генератор буклетов и зин-изданий</p>
      <h1 data-i18n="hero_title">Создавайте полиграфические буклеты</h1>
      <p class="hero-copy" data-i18n="hero_copy">Настраивайте сетки вёрстки, фотографии и типографику прямо в браузере. 225+ комбинаций, готово к печати.</p>

      <div class="hero-actions">
        <button class="primary-button" id="hero-create-btn" type="button" data-i18n="btn_create">Создать буклет — бесплатно</button>
        <a class="secondary-button" href="#collection" data-i18n="btn_see_examples">Смотреть примеры</a>
      </div>
    </div>
  </section>



  <!-- БЛОК КАТЕГОРИЙ (Сразу после Hero) -->
  <section class="category-explorer" id="categories" aria-label="Категории и темы буклетов">
    <div class="category-explorer-inner">
      <div class="category-explorer-header">
        <div class="cat-pill-badge">
          <span class="cat-pill-dot"></span>
          <span>Открытые шаблоны и категории</span>
        </div>
        <p class="cat-subtext">Выберите тему для быстрого фильтра и просмотра готовых страниц:</p>
      </div>
      <div class="category-chips" id="category-chips">
        <button class="category-chip active" type="button" data-category-target="All">
          <span class="cat-icon">✨</span>
          <span class="cat-name">Все буклеты</span>
          <span class="cat-count">60+</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Birthday">
          <span class="cat-icon">🎂</span>
          <span class="cat-name">Праздники и Дни рождения</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Relationships">
          <span class="cat-icon">💍</span>
          <span class="cat-name">Свадьбы и истории</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Food">
          <span class="cat-icon">☕</span>
          <span class="cat-name">Меню и кофейни</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Sports">
          <span class="cat-icon">🏃</span>
          <span class="cat-name">Спорт и активность</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Cinema">
          <span class="cat-icon">🎬</span>
          <span class="cat-name">Кино и фильмы</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Travel">
          <span class="cat-icon">✈️</span>
          <span class="cat-name">Путешествия и гиды</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Music">
          <span class="cat-icon">🎸</span>
          <span class="cat-name">Музыка и фестивали</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Architecture">
          <span class="cat-icon">🏛️</span>
          <span class="cat-name">Архитектура и арт</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Animals">
          <span class="cat-icon">🐾</span>
          <span class="cat-name">Животные и питомцы</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Nature">
          <span class="cat-icon">🌿</span>
          <span class="cat-name">Природа и океан</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Technology">
          <span class="cat-icon">🚀</span>
          <span class="cat-name">Технологии и наука</span>
        </button>
      </div>
    </div>
  </section>


  <section class="collection" id="collection">
    <div class="section-heading">
      <div>
        <p class="eyebrow" data-i18n="collection_eyebrow">Коллекция буклетов</p>
        <h2 data-i18n="collection_title">Коллекция буклетов</h2>
        <p data-i18n="collection_subtitle">Просматривайте готовые editorial-буклеты. Открывайте любой дизайн для настройки типографики, фотосеток или экспорта в PDF.</p>
      </div>
      <div class="collection-controls">
        <div class="filters" id="filters" aria-label="Фильтры буклетов"></div>
        <label class="search-box">
          <span class="sr-only">Поиск буклетов</span>
          <input id="collection-search" type="search" placeholder="Поиск по теме, стилю, дате…" autocomplete="off">
        </label>
      </div>
    </div>
    <div class="booklet-grid" id="booklet-grid" aria-live="polite"></div>
    <p class="empty-state" id="empty-state" hidden>Пока нет концептов, соответствующих этому фильтру.</p>
    <nav class="pagination" id="pagination" aria-label="Навигация буклетов"></nav>
  </section>

  <section class="contact-section" id="contact">
    <div class="contact-card">
      <div class="contact-intro">
        <p class="eyebrow" data-i18n="contact_eyebrow">Связаться с нами</p>
        <h2 data-i18n="contact_title">Контакты и обратная связь</h2>
        <p data-i18n="contact_copy">Есть вопросы, индивидуальные пожелания или идеи для сотрудничества? Напишите нам прямо сейчас.</p>
      </div>
      <form class="contact-form" id="contact-form" action="https://formspree.io/f/meeyvjjd" method="POST">
        <label>
          <span data-i18n="lbl_name">Ваше имя</span>
          <input name="name" type="text" required data-i18n-ph="ph_name" placeholder="Имя или студия">
        </label>
        <label>
          <span data-i18n="lbl_email">Email адрес</span>
          <input name="_replyto" type="email" required data-i18n-ph="ph_email" placeholder="name@example.com">
        </label>
        <label>
          <span data-i18n="lbl_phone">Телефон (опционально)</span>
          <input name="phone" type="tel" data-i18n-ph="ph_phone" placeholder="+7 900 000 0000">
        </label>
        <label class="field-wide">
          <span data-i18n="lbl_message">Сообщение</span>
          <textarea name="message" rows="4" required data-i18n-ph="ph_message" placeholder="Чем мы можем вам помочь?"></textarea>
        </label>
        <button class="primary-button field-wide" type="submit" data-i18n="btn_send_message">Отправить сообщение →</button>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
