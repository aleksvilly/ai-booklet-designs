---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="AI Booklet Designs — уникальные ИИ-буклеты к любому событию" description="ИИ-буклеты для любого человека и к любому событию — подарки на день рождения, меню для кафе, программы мероприятий, свадебные буклеты. Бесплатно, автоматически, готово к печати." lang="ru">
  <Header slot="header" lang="ru" activeNav="home" />

  <section class="hero" id="generate">
    <div class="hero-intro">
      <p class="eyebrow" data-i18n="hero_eyebrow">ИИ-буклеты — бесплатно, автоматически, уникально</p>
      <h1 data-i18n="hero_title">Для любого человека.<br><em>К любому событию.</em></h1>
      <p class="hero-copy" data-i18n="hero_copy">Подарок на день рождения джазовому фанату. Меню для новой кофейни. Программа галерейного вечера. Буклет на свадьбу. Опишите идею — уникальный полиграфический буклет создаётся автоматически.</p>
      <ul class="hero-usecases" aria-label="Примеры использования">
        <li><a href="gifts.html">🎁 <strong>Подарок</strong> — день рождения, юбилей, выпускной</a></li>
        <li><a href="menu.html">☕ <strong>Бизнес</strong> — меню кафе, история бренда, запуск продукта</a></li>
        <li><a href="events.html">🎉 <strong>Событие</strong> — конференция, открытие галереи, фестиваль</a></li>
        <li><a href="wedding.html">💍 <strong>Свадьба</strong> — церемонии, юбилеи, истории любви</a></li>
      </ul>
      <div class="hero-actions">
        <button class="primary-button" id="hero-create-btn" type="button" data-i18n="btn_create">Создать буклет — бесплатно</button>
        <a class="secondary-button" href="#collection" data-i18n="btn_see_examples">Смотреть примеры</a>
        <button class="text-button" id="surprise-button" type="button" data-i18n="btn_surprise">Удиви меня ↗</button>
      </div>
    </div>

    <div class="hero-booklet-entry">
      <button class="hero-booklet-button" id="booklet-plus-btn" type="button" aria-label="Открыть стартовый буклет в редакторе">
        <span class="hero-booklet-shadow" aria-hidden="true"></span>
        <span class="hero-booklet-spread" aria-hidden="true">
          <span class="hero-booklet-page hero-booklet-copy">
            <small>Начните с готового шаблона</small>
            <strong>Сделайте<br><em>по-своему.</em></strong>
            <span>Настройте страницы до генерации.</span>
            <i>Живое превью · Готово к печати</i>
          </span>
          <span class="hero-booklet-page hero-booklet-add">
            <span class="hero-booklet-plus"></span>
            <strong>Открыть редактор</strong>
            <span>Все слайдеры работают сразу</span>
            <span class="hero-slider-preview"><i></i></span>
          </span>
        </span>
      </button>
      <div class="hero-booklet-meta">
        <p><strong>Один клик.</strong> Шаблон буклета и полное меню редактирования откроются вместе.</p>
        <button class="request-history-button" id="request-history-button" type="button" hidden>
          История запросов <span id="request-history-count">0</span>
        </button>
      </div>
    </div>
  </section>

  <section class="collection" id="collection">
    <div class="section-heading">
      <div>
        <p class="eyebrow" data-i18n="collection_eyebrow">Коллекция буклетов</p>
        <h2 data-i18n="collection_title">Коллекция буклетов</h2>
        <p data-i18n="collection_subtitle">Просматривайте готовые editorial-буклеты. Открывайте любой дизайн для настройки типографики, фотосеток или экспорта в PDF.</p>
      </div>
      <div class="collection-controls">
        <div class="filters" id="filters" aria-label="Фильтры буклетов"></div>
        <label class="search-box">
          <span class="sr-only">Поиск буклетов</span>
          <input id="collection-search" type="search" placeholder="Поиск по теме, стилю, дате…" autocomplete="off">
        </label>
      </div>
    </div>
    <div class="booklet-grid" id="booklet-grid" aria-live="polite"></div>
    <p class="empty-state" id="empty-state" hidden>Пока нет концептов, соответствующих этому фильтру.</p>
    <nav class="pagination" id="pagination" aria-label="Навигация буклетов"></nav>
  </section>

  <section class="contact-section" id="contact">
    <div class="contact-card">
      <div class="contact-intro">
        <p class="eyebrow" data-i18n="contact_eyebrow">Связаться с нами</p>
        <h2 data-i18n="contact_title">Контакты и обратная связь</h2>
        <p data-i18n="contact_copy">Есть вопросы, индивидуальные пожелания или идеи для сотрудничества? Напишите нам прямо сейчас.</p>
      </div>
      <form class="contact-form" id="contact-form" action="https://formspree.io/f/meeyvjjd" method="POST">
        <label>
          <span data-i18n="lbl_name">Ваше имя</span>
          <input name="name" type="text" required data-i18n-ph="ph_name" placeholder="Имя или студия">
        </label>
        <label>
          <span data-i18n="lbl_email">Email адрес</span>
          <input name="_replyto" type="email" required data-i18n-ph="ph_email" placeholder="name@example.com">
        </label>
        <label>
          <span data-i18n="lbl_phone">Телефон (опционально)</span>
          <input name="phone" type="tel" data-i18n-ph="ph_phone" placeholder="+7 900 000 0000">
        </label>
        <label class="field-wide">
          <span data-i18n="lbl_message">Сообщение</span>
          <textarea name="message" rows="4" required data-i18n-ph="ph_message" placeholder="Чем мы можем вам помочь?"></textarea>
        </label>
        <button class="primary-button field-wide" type="submit" data-i18n="btn_send_message">Отправить сообщение →</button>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
