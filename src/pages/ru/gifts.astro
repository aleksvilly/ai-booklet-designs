---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="Генератор подарочных буклетов на день рождения на ИИ — Памятные альбомы" description="Бесплатный ИИ генератор подарочных буклетов на день рождения. Создавайте памятные журналы, семейные альбомы и персональные подарки. Готово к печати." lang="ru" categoryFilter="gifts">
  <Header slot="header" lang="ru" activeNav="gifts" />

  <section class="hero" id="gifts-hero">
    <div class="hero-intro">
      <p class="eyebrow">ИИ Верстка Подарочных Альбомов и Историй</p>
      <h1>Подарки на День Рождения<br><em>Дизайны Буклетов</em></h1>
      <p class="hero-copy">Удивите близких персональным полиграфическим буклетом. Идеально для юбилеев, дней рождения, семейных фотоисторий и памятных альбомов.</p>
      <div class="hero-actions">
        <a class="primary-button" href={`${import.meta.env.BASE_URL}/ru/#generation-form`}>Создать подарок — Бесплатно</a>
        <a class="secondary-button" href="#collection">Смотреть примеры</a>
      </div>
    </div>
  </section>

  <section class="collection-section" id="collection">
    <div class="collection-header">
      <div>
        <h2>Коллекция подарочных буклетов</h2>
        <p>Дизайны буклетов для дней рождения, юбилеев и персональных праздников.</p>
      </div>
    </div>
    <div class="booklet-grid" id="booklet-grid"></div>
    <nav class="pagination" id="pagination" aria-label="Навигация буклетов"></nav>
  </section>

  <Footer slot="footer" />
</BaseLayout>
