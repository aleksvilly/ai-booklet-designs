---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="AI Booklet Designs — unique editorial booklets for any occasion" lang="en">
  <Header slot="header" lang="en" activeNav="home" />

  <section class="hero" id="generate">
    <div class="hero-intro">
      <p class="eyebrow" data-i18n="hero_eyebrow">AI-generated editorial booklets — free, automatic, open</p>
      <h1 data-i18n="hero_title">Any person.<br><em>Any occasion.</em></h1>
      <p class="hero-copy" data-i18n="hero_copy">A free browser tool for bespoke booklets, zines, café menus, gifts, and event programs. 225+ modular layout styles, live typography controls, instant export.</p>

      <div class="hero-actions">
        <button class="primary-button" id="hero-create-btn" type="button" data-i18n="btn_create">Create a booklet — free</button>
        <a class="secondary-button" href="#collection" data-i18n="btn_see_examples">See examples</a>
      </div>
    </div>

    <div class="hero-booklet-entry">
      <button class="hero-booklet-button" id="booklet-plus-btn" type="button" aria-label="Open a starter booklet in the live editor">
        <span class="hero-booklet-shadow" aria-hidden="true"></span>
        <span class="hero-booklet-spread" aria-hidden="true">
          <span class="hero-booklet-page hero-booklet-copy">
            <small>Interactive Canvas</small>
            <strong>Live<br><em>Editor.</em></strong>
            <span>Inspect typography, photo layouts, and spreads.</span>
            <i>Free · Instant preview</i>
          </span>
          <span class="hero-booklet-page hero-booklet-add">
            <span class="hero-booklet-plus"></span>
            <strong>Open editor</strong>
            <span>All sliders active live</span>
            <span class="hero-slider-preview"><i></i></span>
          </span>
        </span>
      </button>
      <div class="hero-booklet-meta">
        <p><strong>Open source &amp; free.</strong> Click to launch the live booklet workbench.</p>
        <button class="request-history-button" id="request-history-button" type="button" hidden>
          Request history <span id="request-history-count">0</span>
        </button>
      </div>
    </div>
  </section>


  <!-- CATEGORY QUICK EXPLORER -->
  <section class="category-explorer" id="categories" aria-label="Explore booklet categories">
    <div class="category-explorer-inner">
      <div class="category-explorer-header">
        <div class="cat-pill-badge">
          <span class="cat-pill-dot"></span>
          <span>Templates &amp; Categories</span>
        </div>
        <p class="cat-subtext">Click any category to filter print-ready editorial layouts &amp; live spreads:</p>
      </div>
      <div class="category-chips" id="category-chips">
        <button class="category-chip active" type="button" data-category-target="All">
          <span class="cat-icon">✨</span>
          <span class="cat-name">All Booklets</span>
          <span class="cat-count">60+</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Birthday">
          <span class="cat-icon">🎂</span>
          <span class="cat-name">Birthdays &amp; Gifts</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Relationships">
          <span class="cat-icon">💍</span>
          <span class="cat-name">Weddings &amp; Love</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Food">
          <span class="cat-icon">☕</span>
          <span class="cat-name">Café &amp; Menus</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Sports">
          <span class="cat-icon">🏃</span>
          <span class="cat-name">Sports &amp; Fitness</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Cinema">
          <span class="cat-icon">🎬</span>
          <span class="cat-name">Cinema &amp; Movies</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Travel">
          <span class="cat-icon">✈️</span>
          <span class="cat-name">Travel &amp; City Guides</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Music">
          <span class="cat-icon">🎸</span>
          <span class="cat-name">Music &amp; Festivals</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Architecture">
          <span class="cat-icon">🏛️</span>
          <span class="cat-name">Architecture &amp; Design</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Animals">
          <span class="cat-icon">🐾</span>
          <span class="cat-name">Animals &amp; Wildlife</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Nature">
          <span class="cat-icon">🌿</span>
          <span class="cat-name">Nature &amp; Ocean</span>
        </button>
        <button class="category-chip" type="button" data-category-target="Technology">
          <span class="cat-icon">🚀</span>
          <span class="cat-name">Tech &amp; Space</span>
        </button>
      </div>
    </div>
  </section>


  <section class="collection" id="collection">
    <div class="section-heading">
      <div>
        <p class="eyebrow" data-i18n="collection_eyebrow">Current collection</p>
        <h2 data-i18n="collection_title">Editorial booklet collection</h2>
        <p data-i18n="collection_subtitle">Browse print-ready generated editorial booklets. Open any design to inspect spreads, edit typography, or export PDF.</p>
      </div>
      <div class="collection-controls">
        <div class="filters" id="filters" aria-label="Filter booklets"></div>
        <label class="search-box">
          <span class="sr-only">Search booklets</span>
          <input id="collection-search" type="search" placeholder="Search by topic, style, date…" autocomplete="off">
        </label>
      </div>
    </div>
    <div class="booklet-grid" id="booklet-grid" aria-live="polite"></div>
    <p class="empty-state" id="empty-state" hidden>No concepts match this filter yet.</p>
    <nav class="pagination" id="pagination" aria-label="Booklet navigation"></nav>
  </section>

  <section class="contact-section" id="contact">
    <div class="contact-card">
      <div class="contact-intro">
        <p class="eyebrow" data-i18n="contact_eyebrow">Get in touch</p>
        <h2 data-i18n="contact_title">Contact &amp; feedback</h2>
        <p data-i18n="contact_copy">Have questions, custom requests, or partnership ideas? Send a message directly.</p>
      </div>
      <form class="contact-form" id="contact-form" action="https://formspree.io/f/meeyvjjd" method="POST">
        <label>
          <span data-i18n="lbl_name">Your name</span>
          <input name="name" type="text" required data-i18n-ph="ph_name" placeholder="Name or studio">
        </label>
        <label>
          <span data-i18n="lbl_email">Email address</span>
          <input name="_replyto" type="email" required data-i18n-ph="ph_email" placeholder="name@example.com">
        </label>
        <label>
          <span data-i18n="lbl_phone">Phone number (optional)</span>
          <input name="phone" type="tel" data-i18n-ph="ph_phone" placeholder="+1 234 567 8900">
        </label>
        <label class="field-wide">
          <span data-i18n="lbl_message">Message</span>
          <textarea name="message" rows="4" required data-i18n-ph="ph_message" placeholder="How can we help you?"></textarea>
        </label>
        <button class="primary-button field-wide" type="submit" data-i18n="btn_send_message">Send message →</button>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
