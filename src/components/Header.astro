---
interface Props {
  lang?: string;
  activeNav?: string;
}

const { lang = 'en', activeNav = 'home' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL || '';
---
<header class="site-header">
  <a class="brand" href={`${baseUrl}/`} aria-label="ai-booklet home">
    <span class="brand-mark">AB</span>
    <span class="brand-name">ai-booklet</span>
  </a>

  <div class="header-tools">
    <a class="header-gh-btn" href="https://github.com/aleksvilly/ai-booklet-designs" target="_blank" rel="noopener" aria-label="GitHub Repository">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      <span>GitHub</span>
    </a>

    <div class="lang-picker" id="lang-picker">
      <button class="lang-toggle" id="lang-toggle" type="button" aria-label="Select language" aria-expanded="false">
        <span id="lang-current-flag">{lang === 'ru' ? '🇷🇺' : lang === 'es' ? '🇪🇸' : lang === 'de' ? '🇩🇪' : lang === 'fr' ? '🇫🇷' : lang === 'zh' ? '🇨🇳' : '🇬🇧'}</span>
        <span id="lang-current-code">{lang.toUpperCase()}</span>
      </button>
      <div class="lang-dropdown" id="lang-dropdown" hidden>
        <a class={`lang-option ${lang === 'en' ? 'active' : ''}`} data-lang="en" href={`${baseUrl}/`}><span>🇬🇧</span> English</a>
        <a class={`lang-option ${lang === 'ru' ? 'active' : ''}`} data-lang="ru" href={`${baseUrl}/ru/`}><span>🇷🇺</span> Русский</a>
        <a class={`lang-option ${lang === 'es' ? 'active' : ''}`} data-lang="es" href={`${baseUrl}/es/`}><span>🇪🇸</span> Español</a>
        <a class={`lang-option ${lang === 'de' ? 'active' : ''}`} data-lang="de" href={`${baseUrl}/de/`}><span>🇩🇪</span> Deutsch</a>
        <a class={`lang-option ${lang === 'fr' ? 'active' : ''}`} data-lang="fr" href={`${baseUrl}/fr/`}><span>🇫🇷</span> Français</a>
        <a class={`lang-option ${lang === 'zh' ? 'active' : ''}`} data-lang="zh" href={`${baseUrl}/zh/`}><span>🇨🇳</span> 中文</a>
      </div>
    </div>

    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
      <span class="theme-toggle-icon" aria-hidden="true"></span>
      <span class="theme-toggle-label">Dark</span>
    </button>
  </div>
</header>
