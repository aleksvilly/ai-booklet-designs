---
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  categoryFilter?: string;
}

const {
  title = "AI Booklet Designs — unique editorial booklets for any occasion",
  description = "AI-generated editorial booklets for any person and any occasion — birthday gifts, café menus, event programmes, wedding booklets. Free, automatic, print-ready.",
  lang = "en",
  categoryFilter = ""
} = Astro.props;

const baseUrl = "https://aleksvilly.github.io/ai-booklet-designs";
const isRussian = lang === "ru";
const starterCopy = isRussian ? {
  generate: "Сгенерировать",
  close: "Закрыть форму генерации",
  eyebrow: "Последний шаг",
  title: "Создать по этому дизайну",
  copy: "Настройки редактора уже перенесены. Добавьте тему — остальное можно оставить автоматическим.",
  topic: "О чём будет буклет?",
  topicPlaceholder: "Например: подарок джазовому фанату, меню кафе, свадьба…",
  browse: "Выбрать тему из каталога",
  browseHint: "Категория → тема → подтема",
  search: "Найти тему",
  searchPlaceholder: "Например: теннис, свадьба, ИИ…",
  topicDefault: "Выберите любой уровень. Самый глубокий выбранный уровень станет темой буклета.",
  details: "Дополнительные детали (необязательно)",
  detailsPlaceholder: "Аудитория, настроение, важные факты и чего стоит избегать…",
  submit: "Запустить генерацию →",
  note: "Без регистрации · запрос попадёт в публичную очередь"
} : {
  generate: "Generate",
  close: "Close generation form",
  eyebrow: "Final step",
  title: "Create from this design",
  copy: "Your editor choices are already included. Add a topic and leave everything else automatic.",
  topic: "What is the booklet about?",
  topicPlaceholder: "Birthday gift for a jazz fan, café menu, wedding…",
  browse: "Choose from the topic catalog",
  browseHint: "Category → topic → subtopic",
  search: "Find a topic",
  searchPlaceholder: "Try tennis, wedding, AI…",
  topicDefault: "Choose any level. The deepest selection becomes the booklet topic.",
  details: "Extra details (optional)",
  detailsPlaceholder: "Audience, mood, important facts and anything to avoid…",
  submit: "Start generation →",
  note: "No account needed · your request enters the public queue"
};
const photoCopy = isRussian ? {
  manage: "Управлять фото",
  title: "Фото страницы",
  close: "Закрыть менеджер фотографий",
  intro: "Добавляйте фото на выбранную страницу или повторно используйте изображения из буклета.",
  current: "На этой странице",
  empty: "На этой странице пока нет фотографий.",
  booklet: "В этом буклете",
  bookletHint: "Нажмите на фото, чтобы добавить его на текущую страницу.",
  upload: "С устройства",
  url: "По URL",
  search: "Найти",
  urlPlaceholder: "https://example.com/photo.jpg",
  addUrl: "Добавить",
  searchPlaceholder: "Например: архитектура, джаз, море…",
  searchButton: "Искать",
  allSources: "Все источники",
  localNote: "Загрузки сохраняются только в этом браузере. До 20 фото на страницу.",
  searchEmpty: "Введите запрос — здесь появятся фотографии Openverse и Wikimedia."
} : {
  manage: "Manage photos",
  title: "Page photos",
  close: "Close photo manager",
  intro: "Add photos to the selected page or reuse any image already in this booklet.",
  current: "On this page",
  empty: "This page has no photos yet.",
  booklet: "In this booklet",
  bookletHint: "Select a photo to add it to the current page.",
  upload: "From device",
  url: "From URL",
  search: "Search",
  urlPlaceholder: "https://example.com/photo.jpg",
  addUrl: "Add",
  searchPlaceholder: "Try architecture, jazz, ocean…",
  searchButton: "Search",
  allSources: "All sources",
  localNote: "Uploads stay in this browser. Up to 20 photos per page.",
  searchEmpty: "Enter a query to search Openverse and Wikimedia."
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta name="keywords" content="AI booklet generator, editorial design, print-ready booklet, ИИ буклеты, генератор буклетов, folletos IA, AI Broschüren, brochure design, free booklet maker, booklet templates">
  <meta name="theme-color" content="#f3f0e8" id="theme-color">
  <title>{title}</title>
  <link rel="canonical" href={`${baseUrl}/`}>

  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={`${baseUrl}/`}>
  <meta property="og:site_name" content="AI Booklet Designs">
  <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>

  <link rel="alternate" hreflang="x-default" href={`${baseUrl}/`}>
  <link rel="alternate" hreflang="en" href={`${baseUrl}/`}>
  <link rel="alternate" hreflang="ru" href={`${baseUrl}/ru/`}>
  <link rel="alternate" hreflang="es" href={`${baseUrl}/es/`}>
  <link rel="alternate" hreflang="de" href={`${baseUrl}/de/`}>
  <link rel="alternate" hreflang="fr" href={`${baseUrl}/fr/`}>
  <link rel="alternate" hreflang="zh" href={`${baseUrl}/zh/`}>

  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📖</text></svg>">

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "AI Booklet Designs",
    "url": "https://aleksvilly.github.io/ai-booklet-designs/",
    "description": "AI-generated editorial booklets for any person and any occasion — birthday gifts, café menus, event programmes, wedding booklets. Free, automatic, print-ready.",
    "applicationCategory": "DesignApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript. Requires HTML5.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "author": {
      "@type": "Organization",
      "name": "AI Booklet Designs",
      "url": "https://aleksvilly.github.io/ai-booklet-designs/"
    }
  }
  </script>

  <script is:inline>
    (() => {
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = savedTheme || (prefersDark ? 'dark' : 'light');
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,800;1,700;1,800&family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=DM+Sans:wght@400;500;600;700&family=Fredoka:wght@600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,500;1,500&family=Orbitron:wght@600;800&family=Patrick+Hand&family=Playfair+Display:ital,wght@0,600;1,600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/styles.css`}>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-B9CKVDK7WX" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-B9CKVDK7WX');
  </script>
  <!-- Microsoft Clarity -->
  <script type="text/javascript" is:inline>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xu4n6rz192");
  </script>
</head>
<body data-category-filter={categoryFilter}>
  <slot name="header" />

  <main>
    <slot />
  </main>

  <dialog class="booklet-dialog" id="booklet-dialog">
    <button class="dialog-close" id="dialog-close" type="button" aria-label="Close">×</button>
    <button class="dialog-edit" id="dialog-edit" type="button" hidden>Edit booklet</button>
    <div class="link-popover" id="link-popover" hidden>
      <a class="link-popover-action" id="link-popover-action" href="#" target="_blank" rel="noopener">
        <span>Open link</span>
        <svg class="link-popover-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>
    <div id="dialog-content"></div>
    <div class="editor-page-zoom" id="editor-page-zoom" hidden>
      <button class="editor-page-zoom-toggle" id="editor-page-zoom-toggle" type="button" aria-expanded="false" aria-controls="editor-page-zoom-panel">
        <span>Zoom</span>
        <strong id="editor-page-zoom-badge">1×</strong>
      </button>
      <div class="editor-page-zoom-panel" id="editor-page-zoom-panel" hidden>
        <label for="editor-page-zoom-range">Pages in view</label>
        <input id="editor-page-zoom-range" type="range" min="1" max="4" value="1" step="1">
        <output id="editor-page-zoom-output" for="editor-page-zoom-range">1 page</output>
      </div>
    </div>
    <aside class="booklet-editor" id="booklet-editor" aria-label="Booklet editor" hidden>
      <div class="booklet-editor-heading">
        <div>
          <p class="eyebrow">Live editor</p>
          <h2>Adjust the booklet</h2>
        </div>
        <div class="booklet-editor-heading-actions">
          <button class="starter-generate-button" id="starter-generate-button" type="button" hidden>{starterCopy.generate}</button>
          <label class="editor-compact-scope">
            <select id="editor-scope-compact" aria-label="Apply changes to">
              <option value="booklet">Entire booklet</option>
              <option value="spread">Current spread</option>
              <option value="page">Current page</option>
            </select>
          </label>
          <button class="booklet-editor-close" id="booklet-editor-close" type="button" aria-label="Close editor">×</button>
        </div>
      </div>

      <div class="editor-target-card">
        <label>
          <span>Apply changes to</span>
          <select id="editor-scope" aria-label="Apply changes to">
            <option value="booklet">Entire booklet</option>
            <option value="spread">Current spread</option>
            <option value="page">Current page</option>
          </select>
        </label>
        <p id="editor-target-label">Booklet defaults</p>
      </div>

      <div class="booklet-editor-scroll">
        <fieldset class="editor-group">
          <legend>Design system</legend>
          <label data-editor-parameter="profile">
            <span>Editorial profile</span>
            <select id="editor-profile"></select>
          </label>
          <label data-editor-parameter="visualMode">
            <span>Visual language</span>
            <select id="editor-visual-mode">
              <option value="auto">Automatic</option>
              <option value="minimal">Minimal editorial</option>
              <option value="abstract">Abstract / experimental</option>
              <option value="mixed">Mix minimal + abstract</option>
            </select>
          </label>
        </fieldset>

        <fieldset class="editor-group">
          <legend>Structure</legend>
          <label class="editor-range" data-editor-parameter="layoutComplexity">
            <span>Page complexity <output id="editor-layout-output">2</output> / 5</span>
            <input id="editor-layout-complexity" type="range" min="1" max="5" value="2">
          </label>
          <div class="editor-range editor-images-control" data-editor-parameter="imageCount">
            <label for="editor-image-count">Images <output id="editor-image-output">1</output> / 20</label>
            <input id="editor-image-count" type="range" min="0" max="20" value="1">
            <button class="editor-manage-photos" id="editor-manage-photos" type="button">{photoCopy.manage}</button>
          </div>
          <label class="editor-range editor-photo-layout-control" data-editor-parameter="photoLayout">
            <span>Photo layout</span>
            <select id="editor-photo-layout">
              <option value="auto">Auto (original)</option>
              <option value="full">Fullscreen fill</option>
              <option value="split-v">Vertical split (left · right)</option>
              <option value="split-h">Horizontal split (top · bottom)</option>
              <option value="diagonal">Diagonal / angled</option>
              <option value="masonry">Grid / Masonry</option>
              <option value="circles">Circles &amp; shapes</option>
              <option value="collage">Scattered collage</option>
            </select>
          </label>
          <label class="editor-range" data-editor-parameter="photoLayoutVariant">
            <span>Layout intensity <output id="editor-photo-layout-variant-output">0</output>%</span>
            <input id="editor-photo-layout-variant" type="range" min="-100" max="100" value="0" step="5">
          </label>
          <label class="editor-range editor-layout-system-control" data-editor-parameter="layoutSystem">
            <span>Page layout system</span>
            <select id="editor-layout-system">
              <option value="auto">Auto (original)</option>
              <option value="single-hero-image">Single hero image</option>
              <option value="split-layout">Split layout</option>
              <option value="strict-grid">Strict grid</option>
              <option value="image-heavy-magazine">Image-heavy magazine</option>
              <option value="text-heavy-editorial">Text-heavy editorial</option>
              <option value="white-space-minimal">White space minimal</option>
              <option value="full-bleed">Full bleed</option>
              <option value="asymmetric-modern">Asymmetric modern</option>
              <option value="layered-overlap">Layered overlap</option>
              <option value="framed-gallery">Framed gallery</option>
              <option value="chaotic-collage">Chaotic collage</option>
              <option value="poster-layout">Poster layout</option>
              <option value="modular-cards">Modular cards</option>
              <option value="timeline-flow">Timeline flow</option>
              <option value="vertical-rhythm">Vertical rhythm</option>
            </select>
          </label>
          <label class="editor-range" data-editor-parameter="textAmount">
            <span>Text amount <output id="editor-text-output">2</output> / 5</span>
            <input id="editor-text-amount" type="range" min="1" max="5" value="2">
          </label>
          <label class="editor-range editor-content-position-control" data-editor-parameter="contentPosition">
            <span>Content position</span>
            <select id="editor-content-position">
              <option value="top-left">Top left</option>
              <option value="top-center">Top centre</option>
              <option value="top-right">Top right</option>
              <option value="center-left">Centre left</option>
              <option value="center">Centre</option>
              <option value="center-right">Centre right</option>
              <option value="bottom-left">Bottom left</option>
              <option value="bottom-center">Bottom centre</option>
              <option value="bottom-right">Bottom right</option>
            </select>
          </label>
        </fieldset>

        <fieldset class="editor-group">
          <legend>Typography &amp; space</legend>
          <label class="editor-range" data-editor-parameter="fontScale">
            <span>Font scale <output id="editor-font-output">3</output> / 5</span>
            <input id="editor-font-scale" type="range" min="1" max="5" value="3">
          </label>
          <label class="editor-range" data-editor-parameter="spacing">
            <span>Page spacing <output id="editor-spacing-output">3</output> / 5</span>
            <input id="editor-spacing" type="range" min="1" max="5" value="3">
          </label>
          <label class="editor-range" data-editor-parameter="effectLevel">
            <span>Effects intensity <output id="editor-effect-output">2</output> / 5</span>
            <input id="editor-effect-level" type="range" min="0" max="5" value="2">
          </label>
        </fieldset>

        <fieldset class="editor-group editor-advanced-typography">
          <legend>Advanced typography</legend>
          <div class="editor-typography-target-list" id="editor-typography-target-list" data-editor-parameter="advancedTypography">
            <button type="button" data-typography-target="title">
              <strong>Title</strong>
              <small class="editor-typography-target-summary">Display font</small>
              <span aria-hidden="true">›</span>
            </button>
            <button type="button" data-typography-target="subtitle">
              <strong>Subtitle</strong>
              <small class="editor-typography-target-summary">Accent font</small>
              <span aria-hidden="true">›</span>
            </button>
            <button type="button" data-typography-target="body">
              <strong>Body</strong>
              <small class="editor-typography-target-summary">Body font</small>
              <span aria-hidden="true">›</span>
            </button>
          </div>

          <div class="editor-typography-cascade" id="editor-typography-cascade" hidden>
            <header>
              <button class="editor-typography-back" id="editor-typography-back" type="button">‹ Title</button>
              <div>
                <small>Advanced typography</small>
                <strong id="editor-typography-cascade-title">Title</strong>
              </div>
            </header>

            <div class="editor-typography-setting-list" id="editor-typography-setting-list">
              <button type="button" data-typography-setting="fontFamily"><strong>Font family</strong><small></small><span>›</span></button>
              <button type="button" data-typography-setting="fontWeight"><strong>Font weight</strong><small></small><span>›</span></button>
              <button type="button" data-typography-setting="fontTracking"><strong>Letter spacing</strong><small></small><span>›</span></button>
              <button type="button" data-typography-setting="fontLineHeight"><strong>Line height</strong><small></small><span>›</span></button>
              <label class="editor-typography-inline-toggle" data-typography-setting="fontItalic"><strong>Italic</strong><small></small><input id="editor-font-italic" type="checkbox"></label>
              <label class="editor-typography-inline-toggle" data-typography-setting="fontUnderline"><strong>Underline</strong><small></small><input id="editor-font-underline" type="checkbox"></label>
              <label class="editor-typography-inline-toggle" data-typography-setting="fontUppercase"><strong>Uppercase</strong><small></small><input id="editor-font-uppercase" type="checkbox"></label>
            </div>

            <div class="editor-typography-setting-editor" id="editor-typography-setting-editor" hidden>
              <div class="editor-range editor-font-family-control" data-typography-control="fontFamily">
                <select id="editor-font-family" aria-label="Font family">
                  <option value="DM Sans">DM Sans</option>
                  <option value="Inter">Inter</option>
                  <option value="Barlow Condensed">Barlow Condensed</option>
                  <option value="Bebas Neue">Bebas Neue</option>
                  <option value="Playfair Display">Playfair Display</option>
                </select>
                <datalist id="editor-font-family-marks"></datalist>
              </div>
              <div class="editor-range editor-font-weight-control" data-typography-control="fontWeight">
                <select id="editor-font-weight" aria-label="Font weight">
                  <option value="100">Super light</option>
                  <option value="200">Extra light</option>
                  <option value="300">Light</option>
                  <option value="400" selected>Regular</option>
                  <option value="500">Medium</option>
                  <option value="600">Semi bold</option>
                  <option value="700">Bold</option>
                  <option value="800">Extra bold</option>
                  <option value="900">Super bold</option>
                </select>
              </div>
              <label class="editor-range" data-typography-control="fontTracking">
                <span>Letter spacing <output id="editor-font-tracking-output">0</output>%</span>
                <input id="editor-font-tracking" type="range" min="-10" max="20" value="0">
              </label>
              <label class="editor-range" data-typography-control="fontLineHeight">
                <span>Line height <output id="editor-font-line-height-output">120</output>%</span>
                <input id="editor-font-line-height" type="range" min="60" max="180" value="120" step="5">
              </label>
            </div>
          </div>
        </fieldset>

        <fieldset class="editor-group editor-visibility">
          <legend>Text visibility</legend>
          <div class="editor-visibility-options" data-editor-parameter="visibleContent">
            <label><input id="editor-show-title" type="checkbox" checked><span>Show title</span></label>
            <label><input id="editor-show-subtitle" type="checkbox" checked><span>Show subtitle / page type</span></label>
            <label><input id="editor-show-body" type="checkbox" checked><span>Show main text</span></label>
            <label><input id="editor-show-caption" type="checkbox" checked><span>Show page caption</span></label>
            <label><input id="editor-show-page-number" type="checkbox" checked><span>Show page number</span></label>
            <label><input id="editor-show-source" type="checkbox" checked><span>Show source link</span></label>
            <label><input id="editor-show-image-captions" type="checkbox" checked><span>Show photo captions</span></label>
          </div>
        </fieldset>
      </div>

      <div class="editor-text-mode" id="editor-text-mode" hidden aria-label="Text editor">
        <div class="editor-text-mode-heading">
          <button class="editor-text-back-btn" id="editor-text-back-btn" type="button" aria-label="Cancel text editing">←</button>
          <div class="editor-text-mode-heading-info">
            <span class="eyebrow" id="editor-text-field-eyebrow">Text editor</span>
            <h3 id="editor-text-field-title">Edit text</h3>
          </div>
        </div>
        <div class="editor-text-mode-body">
          <label class="editor-text-field-label" for="editor-text-textarea">
            <span>Text content</span>
            <textarea id="editor-text-textarea" rows="4" placeholder="Enter text..."></textarea>
          </label>
          <label class="editor-text-field-label" id="editor-text-url-group" for="editor-text-url-input" hidden>
            <span>Source URL</span>
            <input id="editor-text-url-input" type="url" placeholder="https://...">
          </label>
        </div>
        <div class="editor-text-mode-actions">
          <button class="editor-text-cancel-btn" id="editor-text-cancel-btn" type="button">Cancel</button>
          <button class="editor-text-save-btn" id="editor-text-save-btn" type="button">Save text</button>
        </div>
      </div>

      <section class="editor-photo-manager" id="editor-photo-manager" aria-labelledby="editor-photo-title" hidden>
        <header class="editor-photo-heading">
          <div>
            <p class="eyebrow" id="editor-photo-page-label">Page 1</p>
            <h3 id="editor-photo-title">{photoCopy.title}</h3>
          </div>
          <button id="editor-photo-close" type="button" aria-label={photoCopy.close}>×</button>
        </header>
        <p class="editor-photo-intro">{photoCopy.intro}</p>

        <section class="editor-photo-section">
          <div class="editor-photo-section-heading">
            <h4>{photoCopy.current}</h4>
            <span id="editor-photo-page-count">0 / 20</span>
          </div>
          <div class="editor-photo-page-list" id="editor-photo-page-list"></div>
          <p class="editor-photo-empty" id="editor-photo-page-empty">{photoCopy.empty}</p>
        </section>

        <section class="editor-photo-section editor-photo-add-section">
          <div class="editor-photo-add-actions" role="group" aria-label="Add a photo">
            <button id="editor-photo-upload-button" type="button">＋ {photoCopy.upload}</button>
            <button id="editor-photo-url-toggle" type="button" aria-expanded="false">↗ {photoCopy.url}</button>
            <button id="editor-photo-search-toggle" type="button" aria-expanded="false">⌕ {photoCopy.search}</button>
          </div>
          <input id="editor-photo-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple hidden>
          <form class="editor-photo-inline-form" id="editor-photo-url-form" hidden>
            <input id="editor-photo-url" type="url" inputmode="url" placeholder={photoCopy.urlPlaceholder} aria-label={photoCopy.url}>
            <button type="submit">{photoCopy.addUrl}</button>
          </form>
          <form class="editor-photo-search-form" id="editor-photo-search-form" hidden>
            <div>
              <input id="editor-photo-search" type="search" placeholder={photoCopy.searchPlaceholder} aria-label={photoCopy.search}>
              <select id="editor-photo-provider" aria-label="Photo source">
                <option value="all">{photoCopy.allSources}</option>
                <option value="openverse">Openverse</option>
                <option value="wikimedia">Wikimedia</option>
              </select>
              <button type="submit">{photoCopy.searchButton}</button>
            </div>
            <div class="editor-photo-search-results" id="editor-photo-search-results"></div>
            <p class="editor-photo-search-empty" id="editor-photo-search-empty">{photoCopy.searchEmpty}</p>
          </form>
          <p class="editor-photo-status" id="editor-photo-status" role="status" aria-live="polite"></p>
          <p class="editor-photo-note">{photoCopy.localNote}</p>
        </section>

        <section class="editor-photo-section">
          <div class="editor-photo-section-heading editor-photo-library-heading">
            <div>
              <h4>{photoCopy.booklet}</h4>
              <p>{photoCopy.bookletHint}</p>
            </div>
            <span id="editor-photo-library-count">0</span>
          </div>
          <div class="editor-photo-library" id="editor-photo-library"></div>
        </section>
      </section>

      <section class="starter-request-panel" id="starter-request-panel" aria-labelledby="starter-request-title" hidden>
        <header>
          <div>
            <p class="eyebrow">{starterCopy.eyebrow}</p>
            <h3 id="starter-request-title">{starterCopy.title}</h3>
          </div>
          <button id="starter-request-close" type="button" aria-label={starterCopy.close}>×</button>
        </header>
        <p class="starter-request-copy">{starterCopy.copy}</p>
        <form class="request-form starter-request-form" id="generation-form" action="https://ntfy.sh/ai-booklet-8bcc753d24dacb6d280ae36b" method="post">
          <input type="hidden" name="request_type" value="booklet_generation">
          <input type="hidden" name="count" value="1">
          <input class="form-honeypot" name="_gotcha" type="text" tabindex="-1" autocomplete="off">

          <label class="starter-topic-field">
            <span>{starterCopy.topic}</span>
            <input id="booklet-topic" name="topic" type="text" maxlength="140" placeholder={starterCopy.topicPlaceholder}>
          </label>
          <input id="topic-path" name="topic_path" type="hidden" value="">

          <details class="topic-explorer" id="topic-explorer">
            <summary>
              <span>{starterCopy.browse}</span>
              <small>{starterCopy.browseHint}</small>
            </summary>
            <div class="topic-explorer-panel">
              <label class="topic-search-label">
                <span>{starterCopy.search}</span>
                <input id="topic-catalog-search" type="search" placeholder={starterCopy.searchPlaceholder} autocomplete="off">
              </label>
              <div class="topic-wheel" id="topic-wheel" aria-label="Topic path"></div>
              <p class="topic-path-preview" id="topic-path-preview">{starterCopy.topicDefault}</p>
              <div class="topic-search-results" id="topic-search-results" hidden></div>
            </div>
          </details>

          <label class="starter-details-field">
            <span>{starterCopy.details}</span>
            <textarea name="description" rows="3" maxlength="800" placeholder={starterCopy.detailsPlaceholder}></textarea>
          </label>

          <div class="starter-form-settings-source" hidden>
            <label id="style-profile-label">
              <select id="style-profile-select" name="style">
                <option value="auto">Automatic / no brand profile</option>
              </select>
            </label>
            <input name="visual_mode" type="hidden" value="auto">
            <input name="layout_complexity" type="hidden" value="2">
            <input name="effect_level" type="hidden" value="2">
            <input name="effects" type="hidden" value="">
            <input name="chaos_level" type="hidden" value="-1">
            <input name="max_fonts" type="hidden" value="20">
            <input name="custom_style" type="hidden" value="">
            <input name="ai_provider" type="hidden" value="auto">
            <input name="custom_fonts" type="hidden" value="">
          </div>

          <button class="primary-button starter-request-submit" type="submit">{starterCopy.submit}</button>
          <p class="form-status" id="generation-form-status" role="status" aria-live="polite"></p>
          <p class="starter-request-note">{starterCopy.note}</p>
        </form>
      </section>

      <div class="editor-parameter-menu" id="editor-parameter-menu" aria-hidden="true"></div>

      <nav class="editor-mini-navigation" aria-label="Editor parameter navigation">
        <button class="editor-parameter-step" id="editor-parameter-previous" type="button" aria-label="Previous parameter">←</button>
        <button class="editor-parameter-summary" id="editor-parameter-menu-toggle" type="button" aria-label="Show all editor parameters" aria-expanded="false">
          <span class="editor-parameter-icon" id="editor-parameter-icon" aria-hidden="true"></span>
          <span class="editor-parameter-summary-text">
            <strong id="editor-parameter-label">Page complexity</strong>
            <span id="editor-parameter-value">2 / 5</span>
          </span>
        </button>
        <button class="editor-parameter-step" id="editor-parameter-next" type="button" aria-label="Next parameter">→</button>
      </nav>

      <div class="booklet-editor-footer">
        <p id="editor-save-status">Changes are saved on this device.</p>
        <div>
          <button id="editor-reset-scope" type="button">Reset this level</button>
          <button id="editor-reset-all" type="button">Reset all</button>
        </div>
      </div>
    </aside>
  </dialog>

  <dialog class="print-settings-dialog" id="print-settings-dialog" aria-describedby="print-settings-description">
    <button class="print-settings-close" id="print-settings-close" type="button" aria-label="Close print settings">×</button>
    <form class="print-settings-form" id="print-settings-form">
      <p class="eyebrow">PDF export</p>
      <h2>Download PDF</h2>
      <p id="print-settings-description">The site renders the opened booklet directly into a PDF, preserving its current fonts, effects and page positions.</p>

      <fieldset class="print-mode-options">
        <legend>Page layout</legend>
        <label>
          <input type="radio" name="print-mode" value="pages" checked>
          <span>
            <strong>Single pages</strong>
            <small>One booklet page on each portrait A4 sheet.</small>
          </span>
        </label>
        <label>
          <input type="radio" name="print-mode" value="spreads">
          <span>
            <strong>Two pages per sheet</strong>
            <small>Two upright booklet pages stacked on one portrait A4 sheet.</small>
          </span>
        </label>
      </fieldset>

      <div class="print-settings-actions">
        <button class="primary-button" id="print-submit-button" type="submit">Download PDF →</button>
        <button class="secondary-button" id="print-cancel-button" type="button">Cancel</button>
      </div>
      <p class="print-settings-status" id="print-settings-status" role="status" aria-live="polite"></p>
    </form>
  </dialog>

  <template id="booklet-card-template">
    <article class="booklet-card">
      <button class="cover" type="button" aria-label="Open booklet concept">
        <span class="cover-kicker"></span>
        <span class="cover-title"></span>
        <span class="cover-number"></span>
        <span class="shape shape-a"></span>
        <span class="shape shape-b"></span>
        <span class="shape shape-c"></span>
      </button>
      <div class="card-copy">
        <p class="card-audience"></p>
        <h3 class="card-title"></h3>
        <p class="card-direction"></p>
      </div>
    </article>
  </template>

  <slot name="footer" />

  <script is:inline src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/vendor/html-to-image.min.js`}></script>
  <script is:inline src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/vendor/jspdf.umd.min.js`}></script>
  <script type="module" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/src/main.js`}></script>
</body>
</html>
